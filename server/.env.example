# Copy this file to .env and fill in real values.

# PostgreSQL. If you're using the included docker-compose.yml as-is, this
# matches it exactly — no changes needed for local dev. For a hosted
# Postgres (Supabase, Neon, RDS, etc.), replace with the connection string
# they give you.
DATABASE_URL="postgresql://convoy:convoy@localhost:5432/convoy?schema=public"

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# Mapbox account → Tokens page (account.mapbox.com/access-tokens).
# The default public token works fine here — this key is used server-side
# for the Directions API call, and separately the app needs its own public
# token at runtime (see app/PLATFORM_SETUP.md).
MAPBOX_ACCESS_TOKEN="your-mapbox-access-token"

PORT=4000
